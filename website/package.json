{
  "name": "pixelcraft-showcase",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-repo-data.mjs",
    "predev": "node scripts/sync-repo-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/sync-repo-data.mjs",
    "build": "vite build",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json README.md",
    "format:check": "prettier --check src scripts index.html vite.config.ts tsconfig.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/silkscreen": "5.2.7",
    "@gsap/react": "2.1.2",
    "gsap": "3.13.0",
    "motion": "12.23.24",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@fontsource-variable/public-sans": "5.2.7",
    "@fontsource-variable/work-sans": "5.2.8",
    "@fontsource/barlow-condensed": "5.2.7",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.13.10",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "5.1.4",
    "playwright": "1.65.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
